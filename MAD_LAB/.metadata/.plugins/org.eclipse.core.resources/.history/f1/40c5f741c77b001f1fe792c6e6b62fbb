    return (x >= rx1 && x <= rx2 && y >= ry1 && y <= ry2);
}

uint16_t rgb565(uint8_t red, uint8_t green, uint8_t blue) {
    // Convert 8-bit RGB to 5-6-5 bit format
    uint16_t r = (red >> 3) & 0x1F;   // 5 bits for Red
    uint16_t g = (green >> 2) & 0x3F; // 6 bits for Green
    uint16_t b = (blue >> 3) & 0x1F;  // 5 bits for Blue

    // Combine the bits into a single 16-bit value
    return (r << 11) | (g << 5) | b;
}

int calculate_abs_difference(int y) {
    return abs(240 - y);
}

void My_Draw_Image(const char *Image_Array, uint8_t x, uint8_t y, uint8_t w, uint8_t h)
{
    ILI9341_Set_Address(x, y, x + w - 1, y + h - 1);
    HAL_GPIO_WritePin(LCD_DC_PORT, LCD_DC_PIN, GPIO_PIN_SET);
    HAL_GPIO_WritePin(LCD_CS_PORT, LCD_CS_PIN, GPIO_PIN_RESET);
    unsigned char Temp_small_buffer[BURST_MAX_SIZE];
    uint32_t counter = 0;
    for (uint32_t i = 0; i < w * h * 2 / BURST_MAX_SIZE; i++)
    {
        for (uint32_t k = 0; k < BURST_MAX_SIZE; k++)
        {
            Temp_small_buffer[k] = Image_Array[counter + k];
        }
        HAL_SPI_Transmit(HSPI_INSTANCE, (unsigned char *)Temp_small_buffer, BURST_MAX_SIZE, 10);
        counter += BURST_MAX_SIZE;
    }
    if ((w * h * 2) % BURST_MAX_SIZE != 0)
    {
        uint32_t remaining = (w * h * 2) % BURST_MAX_SIZE;
        for (uint32_t k = 0; k < remaining; k++)
        {
            Temp_small_buffer[k] = Image_Array[counter + k];
        }
        HAL_SPI_Transmit(HSPI_INSTANCE, (unsigned char *)Temp_small_buffer, remaining, 10);
    }
    HAL_GPIO_WritePin(LCD_CS_PORT, LCD_CS_PIN, GPIO_PIN_SET);
}

